{
  "manifest_version": 3,
  "name": "Lumen — Falling Notes Piano",
  "version": "1.1.0",
  "description": "A cinematic falling-notes piano with glowing tiles, guide hands, built-in songs, MIDI import, and a playable keyboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lumen-piano@near",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open Lumen Piano",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  }
}
